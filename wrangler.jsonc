// Assets-only Worker: Cloudflare serves the built site (`vite build` into dist/)
// with no Worker script. Built files under assets/ have content hashes in their
// names (see public/_headers for caching). The WASM engine is the committed
// src/nw_engine.wasm (Workers Builds has no Rust toolchain): after changing
// engine/, run engine/build.sh and commit its output.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "networkwars",
  "compatibility_date": "2026-11-05",
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist" }
}
