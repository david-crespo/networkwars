# Cloudflare static-asset headers (parsed at deploy, never served).
# Vite puts a content hash in the name of every built file under assets/, so
# those files never change and can be cached for good. Everything else
# (index.html, sw.js) keeps Cloudflare's default revalidate-every-load caching.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
